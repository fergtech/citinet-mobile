{
  "expo": {
    "name": "Citinet Mobile",
    "slug": "citinet-mobile",
    "owner": "fergtech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citinet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.fergtech.citinetmobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Used to find Citinet hubs on your local network so you can connect directly without the internet.",
        "NSBonjourServices": [
          "_citinet._tcp."
        ],
        "NSCameraUsageDescription": "Used for video calls, broadcasts, and rooms.",
        "NSMicrophoneUsageDescription": "Used for calls, broadcasts, and rooms.",
        "UIBackgroundModes": [
          "voip",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/icon-adaptive-background.png",
        "foregroundImage": "./assets/images/icon-512x512.png",
        "monochromeImage": "./assets/images/icon-512x512.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/apple-touch-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to drop an Atlas pin at your current location and to show your distance from nearby pins."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach a photo or video to an Atlas pin, marketplace listing, or file upload.",
          "cameraPermission": "Used to take a photo for an Atlas pin or a marketplace listing."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Used to save downloaded photos and videos to your device."
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc7be00b-11c9-42b2-ae2a-718c084767d4"
      }
    }
  }
}
